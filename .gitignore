# ==========================================
# Ponto a Ponto - .gitignore
# ==========================================

# Dependências
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Builds
/.next/
/out/
/build/
/dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testes & Cobertura
/coverage
*.lcov
.nyc_output

# Variáveis de Ambiente & Segredos
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
# Permite versionar o template de exemplo de variáveis
!.env.example

# Logs & Depuração
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
next-panic-*.log

# Vercel
.vercel

# Editores & IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Arquivos de Sistema Operacional (Windows / macOS / Linux)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

.DS_Store
.AppleDouble
.LSOverride
._*

*~
*.tmp
*.temp
